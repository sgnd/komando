# The client side: openconnect + ocproxy, as a person would install them;
# komando (built for Linux) is mounted at /usr/local/bin/komando. No
# tailscale programs: komando has Tailscale built in.
FROM debian:13-slim
RUN apt-get update -q && apt-get install -y -q --no-install-recommends openconnect ocproxy ca-certificates netcat-openbsd curl \
    && rm -rf /var/lib/apt/lists/*
