# ocserv (Cisco AnyConnect-compatible VPN server) for the e2e test.
FROM debian:13-slim
RUN apt-get update -q && apt-get install -y -q --no-install-recommends ocserv openssl netcat-openbsd iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY ocserv.conf /etc/ocserv/ocserv.conf
COPY ocserv-start.sh /start.sh
RUN chmod +x /start.sh
ENTRYPOINT ["/start.sh"]
