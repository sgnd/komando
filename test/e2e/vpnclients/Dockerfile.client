# The client side: komando (built for Linux) is mounted at
# /usr/local/bin/komando. No openconnect, ocproxy or tailscale programs:
# komando has AnyConnect and Tailscale built in.
FROM debian:13-slim
RUN apt-get update -q && apt-get install -y -q --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
