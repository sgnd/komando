apiVersion: v1
kind: Config
current-context: prod
clusters:
- name: prod
  cluster:
    server: https://127.0.0.1:1
users:
- name: prod
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      command: kubelogin
      args: [get-token]
contexts:
- name: prod
  context:
    cluster: prod
    user: prod
